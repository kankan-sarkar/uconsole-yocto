[Unit]
Description=UConsole First Boot Wizard
After=weston.service
Requires=weston.service

[Service]
Type=oneshot
# Ensure it exports the wayland display variable so PyQt6 can connect to Weston
Environment=WAYLAND_DISPLAY=wayland-1
Environment=QT_QPA_PLATFORM=wayland
# Run as root to write to /etc
User=root
# Only start if the flag file does NOT exist
ConditionPathExists=!/etc/.oobe_completed
ExecStart=/usr/bin/uconsole-oobe

[Install]
WantedBy=graphical.target
